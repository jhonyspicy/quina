{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 静的ファイルだけを配信するWorker。/api/* は同じホスト名のRouteでAPIのWorkerへ振り分ける（ADR 0005）
  "name": "quina-signage",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "quina-signage-staging",
      "routes": [{ "pattern": "signage-staging.quina.poker", "custom_domain": true }]
    }
  }
}
